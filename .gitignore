# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache

# Type checking / linting caches
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/
.pytype/

# Coverage / profiling data
*.prof
*.lprof
.hypothesis/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
*.jks

# SQLite runtime sidecars
# A database file is project content and stays trackable. Only the
# generated files that appear beside it are state.
*-journal
*-wal
*-shm

# Local databases and state
/data/
!data/.gitkeep

# Logs
*.log
logs/
pip-log.txt

# Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local overrides
docker-compose.override.yml
local/

# Workspace-local runtime state, not project source. Anchored to the repo
# root so a nested .forge/ is still visible.
/.forge/

# Written into the workspace root when a process runs with HOME set to the
# repo instead of the operator's home -- a headless Chromium profile and the
# NSS key database it creates. Machine state, never project content.
/.config/
/.local/

# Placeholder file from an agent tool call whose path/content arguments were
# not substituted: the tool wrote <updated-config-content> to a file named
# after its own schema argument.
/<path-to-config-file>