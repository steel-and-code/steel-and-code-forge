# Copy to .env and fill in real values. Never commit .env.
# Placeholder values only — no real secrets in this file.

# --- Application ---
APP_NAME=forge
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# --- OpenRouter (model gateway) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Steel-and-Code-Forge

# --- Forge runtime ---
FORGE_LOG_LEVEL=INFO
FORGE_MAX_CONCURRENT_RUNS=
FORGE_RUN_TIMEOUT_SECONDS=

# --- n8n (automation and triggers) ---
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=

# --- Agent defaults ---
AGENT_DEFAULT_MODEL=
AGENT_DEFAULT_TEMPERATURE=
AGENT_MAX_ITERATIONS=

# --- Persistence (placeholder; no database yet) ---
FORGE_DATABASE_URL=
FORGE_REDIS_URL=

# --- Website client integration ---
STEEL_AND_CODE_SITE_URL=
FORGE_PUBLIC_API_TOKEN=